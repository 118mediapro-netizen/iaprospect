# ── Configuration IAProspect ────────────────────────────────────────────────
# Copiez ce fichier en « .env » puis renseignez vos valeurs.

# Clé API Anthropic (obligatoire pour l'analyse IA des annonces).
# Obtenez-la sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# E-mail de l'utilisateur par défaut (optionnel).
IAPROSPECT_USER_EMAIL=demo@iaprospect.local
